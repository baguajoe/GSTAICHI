# Copy this file to .env for local development:  cp .env.example .env
# On Render, set the same names under Environment (render.yaml lists which service needs which).
# Never commit .env. Never put a secret in a "Front-End" variable: those end up in the public website files.
# How to create each account and key, step by step: docs/LAUNCH_CHECKLIST.md

# ============ Front-End (built into public/bundle.js, visible to anyone) ============
# Only the names allowlisted in webpack.common.js (FRONTEND_ENV) reach the browser.

# Address of the Flask API. Local: your Codespaces port 3001 address. Live: e.g. https://api.gstaichi.org
BACKEND_URL=
# Leave as / unless the site lives in a sub-folder
BASENAME=/
# PayPal REST app "Client ID" (public by design). developer.paypal.com > Apps & Credentials.
# Use the Sandbox app's ID while PAYPAL_MODE=sandbox and the Live app's ID at launch.
PAYPAL_CLIENT_ID=

# ============ Back-End: core ============
# PostgreSQL. Local Codespaces default below. Live: Render > your database > "Internal Database URL"
DATABASE_URL=postgres://gitpod:postgres@localhost:5432/example
FLASK_APP=src/app.py
# 1 locally, 0 live
FLASK_DEBUG=1
DEBUG=TRUE
# Signs the /admin sign-in cookie. Any long random text: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_APP_KEY=
# Signs member sign-ins. Long random text (same command as above). Changing it signs everyone out.
JWT_SECRET_KEY=
# The website's address, used in email links and to allow the browser to call the API.
# Live: https://gstaichi.org (the www. address is allowed automatically)
FRONTEND_URL=

# ============ Video protection ============
# Encrypts the video keys stored in the database. Generate ONCE:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a safe copy. If it is lost or changed, every uploaded video stops playing and must be uploaded again.
KEY_ENCRYPTION_SECRET=
# Signs the short-lived video addresses. Long random text; must be identical on Render and in the
# Cloudflare Worker (npx wrangler secret put MEDIA_TOKEN_SECRET).
MEDIA_TOKEN_SECRET=
# Where the Cloudflare Worker serves videos
MEDIA_BASE_URL=https://media.gstaichi.org

# ============ Cloudflare R2 (video storage, both buckets PRIVATE) ============
# dash.cloudflare.com > R2 > Overview: the Account ID is shown on the right.
R2_ACCOUNT_ID=
# R2 > Manage R2 API Tokens > Create API token, permission "Object Read & Write", limited to the two buckets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MASTERS_BUCKET=taichi-masters
R2_STREAMS_BUCKET=taichi-streams
# Only for testing against another S3-compatible store; leave empty to use R2_ACCOUNT_ID
R2_ENDPOINT_URL=

# ============ PayPal subscriptions ============
# sandbox while testing, live at launch (see docs/LAUNCH_CHECKLIST.md)
PAYPAL_MODE=sandbox
# developer.paypal.com > Apps & Credentials > your app > Secret (Sandbox or Live, matching PAYPAL_MODE)
PAYPAL_CLIENT_SECRET=
# developer.paypal.com > your app > Webhooks > the webhook for https://<api>/api/tcc/paypal/webhook > Webhook ID
PAYPAL_WEBHOOK_ID=
# Only for automated tests with a fake PayPal; leave empty
PAYPAL_API_BASE=

# ============ Email ============
# Gmail address that sends password resets and notices, and a Google "App password" for it
# (myaccount.google.com > Security > 2-Step Verification > App passwords). Not the normal Gmail password.
GMAIL=
GMAIL_PASSWORD=
# Where the old site's contact forms are sent (Tai Chi Company notices use Site Settings > Notification Email)
NOTIFICATION_EMAIL=
# console = print emails instead of sending them (local development and tests). Leave empty live.
EMAIL_MODE=

# ============ Optional ============
# Shared rate-limit storage (Render Key Value / Redis). Empty = each API process keeps its own count.
REDIS_URL=
# Background worker only: ffmpeg speed/quality preset (veryfast is a good balance)
ENCODE_PRESET=veryfast
# Set to false ONLY for local automated tests
RATELIMIT_ENABLED=true
